*.iso

# Environment — contains real IPs and credentials
.env

# Downloaded OS images and extracted boot files (populated by Ansible)
data/

# SSH keys
*.pem
*.key
id_rsa
id_ed25519

# Vault password files
.vault_pass
.vault_password

# Python cache
__pycache__/
*.pyc

# Editor / OS
.DS_Store
*.swp
*.swo
*~
