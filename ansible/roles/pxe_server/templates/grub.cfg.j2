# GRUB2 EFI PXE boot menu
# Generated by Ansible — edit the role template, not this file.

set default=0
set timeout=30
set timeout_style=menu

insmod all_video
terminal_output console

# ── Ubuntu 22.04 LTS ─────────────────────────────────────────────────────────
{% if ubuntu2204_enabled %}
{% for profile in ubuntu2204_profiles + ubuntu2204_extra_profiles %}
menuentry "Install {{ profile.label }}" --id {{ profile.name }} {
    echo "Loading Ubuntu 22.04 kernel..."
    linux  /boot/ubuntu2204/vmlinuz \
           root=/dev/ram0 \
           ip=dhcp \
           url=http://{{ http_server_ip }}/ubuntu/22.04/ubuntu-22.04-live-server-amd64.iso \
           autoinstall \
           ds=nocloud-net\;s=http://{{ http_server_ip }}/cloud-init/{{ profile.name }}/ \
           console=tty0
    echo "Loading Ubuntu 22.04 initrd..."
    initrd /boot/ubuntu2204/initrd
}

{% endfor %}
menuentry "Install Ubuntu 22.04 LTS (interactive)" --id ubuntu2204-interactive {
    linux  /boot/ubuntu2204/vmlinuz \
           root=/dev/ram0 \
           ip=dhcp \
           url=http://{{ http_server_ip }}/ubuntu/22.04/ubuntu-22.04-live-server-amd64.iso \
           console=tty0
    initrd /boot/ubuntu2204/initrd
}
{% endif %}

# ── Rocky Linux 9 ─────────────────────────────────────────────────────────────
{% if rocky9_enabled %}
{% for profile in rocky9_profiles + rocky9_extra_profiles %}
menuentry "Install {{ profile.label }}" --id {{ profile.name }} {
    echo "Loading Rocky Linux 9 kernel..."
    linux  (http,{{ http_server_ip }})/rocky/9/images/pxeboot/vmlinuz \
           ip=dhcp \
           inst.stage2=http://{{ http_server_ip }}/rocky/9/ \
           inst.ks=http://{{ http_server_ip }}/kickstart/{{ profile.name }}.ks \
           inst.repo=http://{{ http_server_ip }}/rocky/9/ \
           console=tty0
    echo "Loading Rocky Linux 9 initrd..."
    initrd (http,{{ http_server_ip }})/rocky/9/images/pxeboot/initrd.img
}

{% endfor %}
menuentry "Install Rocky Linux 9 (interactive)" --id rocky9-interactive {
    linux  (http,{{ http_server_ip }})/rocky/9/images/pxeboot/vmlinuz \
           ip=dhcp \
           inst.stage2=http://{{ http_server_ip }}/rocky/9/ \
           inst.repo=http://{{ http_server_ip }}/rocky/9/ \
           inst.graphical \
           console=tty0
    initrd (http,{{ http_server_ip }})/rocky/9/images/pxeboot/initrd.img
}
{% endif %}

# ── Utilities ─────────────────────────────────────────────────────────────────
menuentry "Boot from local disk" --id local {
    exit
}
