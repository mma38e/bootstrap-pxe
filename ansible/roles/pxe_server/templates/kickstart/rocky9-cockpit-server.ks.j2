#version=RHEL9
# Rocky Linux 9 Kickstart — Cockpit/Virtualization Server
# Generated by Ansible — edit the role template, not this file.

text
reboot

url --url=http://{{ http_server_ip }}/rocky/9/

lang en_US.UTF-8
keyboard --vckeymap=us --xlayouts=us
timezone America/New_York --utc

network --bootproto=dhcp --onboot=yes --activate

# CHANGEME: generate with: openssl passwd -6 yourpassword
rootpw --iscrypted $6$3v0PVotyZ1K4dQSN$PYxKDGgDJ6HGIsR81bnwCRZZdCPtXHpd6qlDMNuN6JOhK6.Tvc1GNyXHOgiX0sISZRTx7c7iFIn/uvFnRqJjI. #password = password
user --name=user --password=password --plaintext --groups=wheel
selinux --permissive
firstboot --disable
skipx

zerombr
clearpart --all --initlabel
reqpart --add-boot
part / --fstype=xfs --size=1 --grow
bootloader --append="rhgb quiet crashkernel=1G-4G:192M,4G-64G:256M,64G-:512M"

firewall --enabled --service=ssh --service=cockpit

%packages
@^virtualization-host-environment
@smart-card
@security-tools
@system-tools
@virtualization-platform
openscap
openscap-utils
cockpit-machines
screen
htop
minicom
nmap-ncat
socat
tcpdump
vim
nano
tree
curl
wget
grep
tar
%end

%post --log=/root/ks-post.log
# Replace default repos with local PXE HTTP server
rm -f /etc/yum.repos.d/rocky*.repo

cat > /etc/yum.repos.d/pxe-local.repo << 'EOF'
[baseos-local]
name=Rocky Linux 9 - BaseOS (PXE Local)
baseurl=http://{{ http_server_ip }}/rocky/9/BaseOS/
enabled=1
gpgcheck=0
priority=10

[appstream-local]
name=Rocky Linux 9 - AppStream (PXE Local)
baseurl=http://{{ http_server_ip }}/rocky/9/AppStream/
enabled=1
gpgcheck=0
priority=10
EOF

systemctl enable sshd
systemctl enable cockpit.socket
echo "Kickstart install complete (cockpit-server)" >> /root/ks-post.log
%end
