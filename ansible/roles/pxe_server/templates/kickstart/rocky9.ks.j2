#version=RHEL9
# Rocky Linux 9 Kickstart
# Generated by Ansible — edit the role template, not this file.

install
text
reboot

url --url=http://{{ http_server_ip }}/rocky/9/

lang en_US.UTF-8
keyboard --vckeymap=us --xlayouts=us
timezone UTC --isUtc

network --bootproto=dhcp --onboot=yes --activate
network --hostname=rocky9-pxe

# CHANGEME: generate with: openssl passwd -6 yourpassword
rootpw --iscrypted $6$9t9B7WM.b8UMrOnW$Fy02O2NwuAsTLprS8wuH4.br7dYzLgIZZUALb/BfpPV333/huImUDrs1QGhDIOg0JxKHfxEOZfdM7vN15aKVl0
selinux --enforcing
firewall --enabled --service=ssh

zerombr
clearpart --all --initlabel
autopart --type=lvm
bootloader --location=mbr

%packages
@^minimal-environment
openssh-server
%end

%post --log=/root/ks-post.log
# Replace default repos with local PXE HTTP server
rm -f /etc/yum.repos.d/rocky*.repo

cat > /etc/yum.repos.d/pxe-local.repo << 'EOF'
[baseos-local]
name=Rocky Linux 9 - BaseOS (PXE Local)
baseurl=http://{{ http_server_ip }}/rocky/9/BaseOS/
enabled=1
gpgcheck=0
priority=10

[appstream-local]
name=Rocky Linux 9 - AppStream (PXE Local)
baseurl=http://{{ http_server_ip }}/rocky/9/AppStream/
enabled=1
gpgcheck=0
priority=10
EOF

systemctl enable sshd
echo "Kickstart install complete" >> /root/ks-post.log
%end
