# pxelinux.cfg/default — BIOS syslinux boot menu
# Generated by Ansible — edit the role template, not this file.

DEFAULT menu.c32
PROMPT 0
TIMEOUT 300
ONTIMEOUT local

MENU TITLE  PXE Boot Menu
MENU COLOR  title       * #FFFFFFFF *
MENU COLOR  border      * #FF000000 *
MENU COLOR  sel         * #FF000000 #FFDDDD00 *

{% if ubuntu2204_enabled %}
{% for profile in ubuntu2204_profiles + ubuntu2204_extra_profiles %}
LABEL {{ profile.name }}
    MENU LABEL Install {{ profile.label }}
    KERNEL /boot/ubuntu2204/vmlinuz
    APPEND initrd=/boot/ubuntu2204/initrd root=/dev/ram0 ip=dhcp url=http://{{ http_server_ip }}/ubuntu/22.04/ubuntu-22.04-live-server-amd64.iso autoinstall ds=nocloud-net;s=http://{{ http_server_ip }}/cloud-init/{{ profile.name }}/ console=tty0

{% endfor %}
LABEL ubuntu2204-interactive
    MENU LABEL Install Ubuntu 22.04 LTS (interactive)
    KERNEL /boot/ubuntu2204/vmlinuz
    APPEND initrd=/boot/ubuntu2204/initrd root=/dev/ram0 ip=dhcp url=http://{{ http_server_ip }}/ubuntu/22.04/ubuntu-22.04-live-server-amd64.iso console=tty0

{% endif %}
{% if rocky9_enabled %}
{% for profile in rocky9_profiles + rocky9_extra_profiles %}
LABEL {{ profile.name }}
    MENU LABEL Install {{ profile.label }}
    KERNEL /boot/rocky9/vmlinuz
    APPEND initrd=/boot/rocky9/initrd.img ip=dhcp inst.stage2=http://{{ http_server_ip }}/rocky/9/ inst.ks=http://{{ http_server_ip }}/kickstart/{{ profile.name }}.ks inst.repo=http://{{ http_server_ip }}/rocky/9/ console=tty0

{% endfor %}
LABEL rocky9-interactive
    MENU LABEL Install Rocky Linux 9 (interactive)
    KERNEL /boot/rocky9/vmlinuz
    APPEND initrd=/boot/rocky9/initrd.img ip=dhcp inst.stage2=http://{{ http_server_ip }}/rocky/9/ inst.repo=http://{{ http_server_ip }}/rocky/9/ console=tty0

{% endif %}
LABEL local
    MENU LABEL Boot from local disk
    LOCALBOOT 0
