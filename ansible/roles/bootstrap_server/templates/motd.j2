#!/bin/bash
# /etc/profile.d/bootstrap-motd.sh
# Displayed at every interactive login — values computed at login time.
# Managed by Ansible (bootstrap_server role). Do not edit manually.

IP=$(hostname -I 2>/dev/null | awk '{print $1}')
UPTIME=$(uptime -p 2>/dev/null || echo "unknown")
KERNEL=$(uname -r)
OS=$(. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME}" || echo "unknown")
DOCKER=$(systemctl is-active docker 2>/dev/null || echo "inactive")
{% if cockpit_enabled | bool %}
COCKPIT=$(systemctl is-active cockpit.socket 2>/dev/null || echo "inactive")
{% endif %}

# /etc/bootstrap-pxe-release is written by bootstrap.ks at install time and
# identifies which baseline release this host was provisioned from.
if [[ -r /etc/bootstrap-pxe-release ]]; then
    BASELINE=$(. /etc/bootstrap-pxe-release 2>/dev/null && echo "${VERSION} (built ${BUILD_DATE})")
else
    BASELINE="unknown"
fi

echo "==========================================================="
echo "  {{ 'Bootstrap Server' if (install_desktop | bool) else 'Docker Host' }} — $(hostname -s)"
echo "==========================================================="
printf "  IP:       %s\n" "${IP:-unknown}"
printf "  OS:       %s\n" "${OS}"
printf "  Kernel:   %s\n" "${KERNEL}"
printf "  Baseline: %s\n" "${BASELINE}"
printf "  Uptime:   %s\n" "${UPTIME}"
echo ""
printf "  Docker:   %s\n" "${DOCKER}"
{% if cockpit_enabled | bool %}
printf "  Cockpit:  %s\n" "${COCKPIT}"
{% endif %}
echo ""
echo "  Role:     {{ 'Ansible Controller / Bootstrap Node' if (install_desktop | bool) else 'Docker Host' }}"
echo "==========================================================="
echo "  Useful commands:"
echo "    docker ps              — list running containers"
echo "    cd /root/bootstrap     — bootstrap artifacts"
echo "    /opt/bootstrap/        — project data directory"
echo "==========================================================="
echo "  Post-Setup Quick Reference"
echo "==========================================================="
echo "  Change admin password (default is 'password'):"
echo "    passwd {{ bootstrap_admin_user }}"
echo ""
{% if cockpit_enabled | bool %}
echo "  Cockpit web console:"
echo "    https://${IP:-this-host}:9090"
echo ""
{% endif %}
{% if install_xrdp | bool %}
echo "  Remote desktop (RDP):"
echo "    ${IP:-this-host}:3389"
echo ""
{% endif %}
echo "==========================================================="
